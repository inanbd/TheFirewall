<Window x:Class="TheFirewall.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TheFirewall.App.ViewModels"
        xmlns:pages="clr-namespace:TheFirewall.App.Views.Pages"
        Title="TheFirewall"
        Icon="/Assets/TheFirewall.ico"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><pages:DashboardPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ActivityViewModel}"><pages:ActivityPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:BansViewModel}"><pages:BansPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:RulesViewModel}"><pages:RulesPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ListsViewModel}"><pages:ListsPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SourcesViewModel}"><pages:SourcesPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CountriesViewModel}"><pages:CountriesPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:FeedsViewModel}"><pages:FeedsPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutViewModel}"><pages:AboutPage /></DataTemplate>

    <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:PageViewModel}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Width="20" />
        <TextBlock Text="{Binding Title}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      </StackPanel>
    </DataTemplate>

    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Protection}" Value="Protected">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Protection}" Value="Paused">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Protection}" Value="Attention">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation -->
    <Grid Margin="8,4,4,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Margin="12,12,12,18">
        <StackPanel Orientation="Horizontal">
          <Image Source="/Assets/Logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="TheFirewall" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="{Binding MachineName}" Style="{StaticResource Caption}" />
          </StackPanel>
        </StackPanel>
        <Border Style="{StaticResource Pill}" Margin="0,14,0,0" Padding="10,4">
          <StackPanel Orientation="Horizontal">
            <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <ListBox Grid.Row="1" Style="{StaticResource NavList}" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
               ItemTemplate="{StaticResource NavItemTemplate}" AutomationProperties.Name="Main navigation" />

      <StackPanel Grid.Row="2">
        <Button Style="{StaticResource SubtleButton}" Margin="0,0,0,6" Command="{Binding RestartAsAdministratorCommand}"
                Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Stretch"
                ToolTip="TheFirewall is running without administrator rights, so settings are read-only.">
          <StackPanel Orientation="Horizontal" Margin="2,2">
            <TextBlock Text="&#xE7EF;" Style="{StaticResource Glyph}" Width="20" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <TextBlock Text="Unlock changes (admin)" Margin="14,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding FooterPages}" SelectedItem="{Binding SelectedFooterPage}"
                 ItemTemplate="{StaticResource NavItemTemplate}" AutomationProperties.Name="Settings navigation" />
      </StackPanel>
    </Grid>

    <!-- Content -->
    <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,16,32,0">
          <Border Style="{StaticResource InfoBar}" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <TextBlock Margin="10,0,0,0" Style="{StaticResource Body}" VerticalAlignment="Center"
                         Text="Demo mode - everything you see is simulated. Nothing is changed on this computer." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource WarningBar}" Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVisibility}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
              <TextBlock Grid.Column="1" Margin="10,0" Style="{StaticResource Body}" VerticalAlignment="Center"
                         Text="You can look around, but changing settings needs administrator permission." />
              <Button Grid.Column="2" Content="Restart as administrator" Command="{Binding RestartAsAdministratorCommand}" />
            </Grid>
          </Border>
        </StackPanel>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
