<UserControl x:Class="TheFirewall.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TheFirewall.App.ViewModels"
             xmlns:controls="clr-namespace:TheFirewall.App.Controls"
             xmlns:data="clr-namespace:TheFirewall.Core.Data;assembly=TheFirewall.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DashboardViewModel}">
  <UserControl.Resources>
    <Style x:Key="HeroGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="Text" Value="&#xEA18;" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Protection}" Value="Protected">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Protection}" Value="Paused">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
          <Setter Property="Text" Value="&#xE769;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Protection}" Value="Attention">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Protection}" Value="Offline">
          <Setter Property="Text" Value="&#xE7BA;" />
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HeroBackground" TargetType="Ellipse">
      <Setter Property="Fill" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Protection}" Value="Protected">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Protection}" Value="Paused">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Protection}" Value="Attention">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Protection}" Value="Offline">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="BarTemplate" DataType="{x:Type vm:BarItem}">
      <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:CountryFlag Code="{Binding Code}" Margin="0,0,8,0" Visibility="{Binding Code, Converter={StaticResource NullToVisibility}}" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock Grid.Column="2" Text="{Binding Count, Converter={StaticResource Number}}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
        <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Height="4" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,16,32,32">
      <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />

      <!-- Protection status -->
      <Border Style="{StaticResource Card}" Margin="0,20,0,12" Padding="24,20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Width="64" Height="64">
            <Ellipse Style="{StaticResource HeroBackground}" />
            <TextBlock Style="{StaticResource HeroGlyph}" HorizontalAlignment="Center" />
          </Grid>
          <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding HeroTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding HeroText}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
          </StackPanel>
          <Button Grid.Column="2" VerticalAlignment="Center" MinWidth="150" Padding="16,8"
                  Content="{Binding PrimaryActionText}" Command="{Binding PrimaryActionCommand}"
                  Visibility="{Binding PrimaryActionText, Converter={StaticResource NullToVisibility}}" />
        </Grid>
      </Border>

      <!-- Warnings -->
      <ItemsControl ItemsSource="{Binding Status.Warnings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource WarningBar}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Numbers -->
      <UniformGrid Columns="4" Margin="-6,0,-6,6">
        <Border Style="{StaticResource Card}" Margin="6">
          <StackPanel>
            <TextBlock Text="Failed logins" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding Stats.FailedLast24h, Converter={StaticResource Number}}" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
            <TextBlock Text="last 24 hours" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6">
          <StackPanel>
            <TextBlock Text="New bans" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding Stats.BansLast24h, Converter={StaticResource Number}}" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
            <TextBlock Text="last 24 hours" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6">
          <StackPanel>
            <TextBlock Text="Banned right now" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding Stats.ActiveBans, Converter={StaticResource Number}}" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
            <Button Style="{StaticResource LinkButton}" Content="View banned addresses" Command="{Binding OpenBansCommand}" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6">
          <StackPanel>
            <TextBlock Text="Being watched" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding Stats.WatchedAddresses, Converter={StaticResource Number}}" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
            <TextBlock Text="addresses with failed logins" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Chart -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <RadioButton Content="24 hours" GroupName="ChartRange" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,4"
                           IsChecked="{Binding ShowMonth, Converter={StaticResource InverseBoolean}}" />
              <RadioButton Content="30 days" GroupName="ChartRange" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,4" Margin="6,0,0,0"
                           IsChecked="{Binding ShowMonth}" />
            </StackPanel>
          </Grid>
          <controls:BarChart Height="210" Margin="0,16,0,4" Values="{Binding ChartValues}" LineValues="{Binding ChartLine}" Labels="{Binding ChartLabels}"
                             BarBrush="{DynamicResource AccentFillColorDefaultBrush}" LineBrush="{DynamicResource SystemFillColorCriticalBrush}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <StackPanel Orientation="Horizontal" Margin="36,6,0,0">
            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Failed logins" Style="{StaticResource Caption}" Margin="6,0,18,0" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowMonth, Converter={StaticResource InverseBoolToVisibility}}">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Bans" Style="{StaticResource Caption}" Margin="6,0,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Top lists -->
      <Grid Margin="-6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="6,0,6,12">
          <StackPanel>
            <TextBlock Text="Attacks by country" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
            <ItemsControl ItemsSource="{Binding TopCountries}" ItemTemplate="{StaticResource BarTemplate}" />
            <TextBlock Text="No failed logins in the last 24 hours." Style="{StaticResource Caption}"
                       Visibility="{Binding TopCountries.Count, Converter={StaticResource ZeroToVisibility}}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,6,12">
          <StackPanel>
            <TextBlock Text="User names tried" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
            <ItemsControl ItemsSource="{Binding TopUserNames}" ItemTemplate="{StaticResource BarTemplate}" />
            <TextBlock Text="Nothing yet." Style="{StaticResource Caption}"
                       Visibility="{Binding TopUserNames.Count, Converter={StaticResource ZeroToVisibility}}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,6,12">
          <StackPanel>
            <TextBlock Text="Targeted services" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
            <ItemsControl ItemsSource="{Binding TopSources}" ItemTemplate="{StaticResource BarTemplate}" />
            <TextBlock Text="Nothing yet." Style="{StaticResource Caption}"
                       Visibility="{Binding TopSources.Count, Converter={StaticResource ZeroToVisibility}}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Recent activity -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,8">
            <TextBlock Text="Recent activity" Style="{StaticResource SectionTitle}" />
            <Button Style="{StaticResource LinkButton}" Content="Open live activity" Command="{Binding OpenActivityCommand}" HorizontalAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Recent}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type data:ActivityEntry}">
                <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Stretch" Padding="8,8"
                        Command="{Binding DataContext.ShowAddressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding IPAddress}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Type, Converter={StaticResource ActivityGlyph}}" Style="{StaticResource Glyph}" FontSize="14"
                               Foreground="{Binding Type, Converter={StaticResource ActivityBrush}}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" MinWidth="230">
                      <controls:CountryFlag Code="{Binding Country}" Margin="0,0,8,0" Visibility="{Binding Country, Converter={StaticResource NullToVisibility}}"
                                            ToolTip="{Binding Country, Converter={StaticResource CountryName}}" />
                      <TextBlock Text="{Binding IPAddress}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="12,0">
                      <Run Text="{Binding Type, Converter={StaticResource ActivityText}, Mode=OneWay}" FontWeight="SemiBold" />
                      <Run Text="{Binding Source, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <Run Text="{Binding UserName, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <Run Text="{Binding Message, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Grid.Column="3" Text="{Binding TimeUtc, Converter={StaticResource RelativeTime}}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" ToolTip="{Binding TimeUtc, Converter={StaticResource LocalTime}}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No activity yet. Failed logins will show up here as soon as they happen." Style="{StaticResource Caption}"
                     Visibility="{Binding Recent.Count, Converter={StaticResource ZeroToVisibility}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
