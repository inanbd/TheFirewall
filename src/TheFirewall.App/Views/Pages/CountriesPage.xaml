<UserControl x:Class="TheFirewall.App.Views.Pages.CountriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TheFirewall.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CountriesViewModel}">
  <Grid Margin="32,16,32,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Countries" Style="{StaticResource PageTitle}" />
      <TextBlock Style="{StaticResource PageSubtitle}" MaxWidth="720" HorizontalAlignment="Left"
                 Text="Block traffic from whole countries, or allow only the countries you work from. Your whitelist and local network are never blocked." />
    </StackPanel>

    <!-- Mode -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <RadioButton GroupName="Mode" IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Off}">
            <TextBlock Style="{StaticResource Body}"><Run Text="Off" FontWeight="SemiBold" /><Run Text=" - no country blocking" /></TextBlock>
          </RadioButton>
          <RadioButton GroupName="Mode" Margin="0,8,0,0" IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=BlockSelected}">
            <TextBlock Style="{StaticResource Body}"><Run Text="Block the selected countries" FontWeight="SemiBold" /></TextBlock>
          </RadioButton>
          <RadioButton GroupName="Mode" Margin="0,8,0,0" IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=AllowOnlySelected}">
            <TextBlock Style="{StaticResource Body}"><Run Text="Allow only the selected countries" FontWeight="SemiBold" /><Run Text=" - block everyone else" /></TextBlock>
          </RadioButton>
        </StackPanel>
        <StackPanel Grid.Column="1" Width="300" Margin="24,0,0,0">
          <TextBlock Text="Apply to these ports only" Style="{StaticResource Body}" />
          <TextBox Text="{Binding Ports, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" IsEnabled="{Binding IsModeOff, Converter={StaticResource InverseBoolean}}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="e.g. 3389, 22, 1433. Leave empty to block every port." />
          <TextBlock Text="{Binding DatabaseText}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Update monthly" IsChecked="{Binding AutoUpdate}" />
            <Button Style="{StaticResource LinkButton}" Content="Update now" Command="{Binding UpdateDatabaseCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Filter -->
    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" VerticalContentAlignment="Center" />
        <TextBlock Text="Find a country…" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center"
                   Style="{StaticResource Caption}" Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
      </Grid>
      <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="150" ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}" SelectedIndex="0" />
      <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" Content="Selected only" IsChecked="{Binding ShowSelectedOnly}" Margin="16,0,0,0" VerticalAlignment="Center" />
      <TextBlock Grid.Column="3" Text="{Binding SelectionSummary}" Style="{StaticResource Caption}" Margin="16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      <Button Grid.Column="4" Style="{StaticResource LinkButton}" Content="Clear selection" Command="{Binding ClearSelectionCommand}" VerticalAlignment="Center" />
    </Grid>

    <!-- Countries -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,8" Margin="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding View}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemWidth="250" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:CountryItem}">
              <CheckBox IsChecked="{Binding IsSelected}" Margin="4,5" ToolTip="{Binding RangeCount, StringFormat={}{0:N0} address ranges}">
                <StackPanel Orientation="Horizontal">
                  <Border Style="{StaticResource CountryBadge}">
                    <TextBlock Text="{Binding Code}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  </Border>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Save bar -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
        <Run Text="IP geolocation by" /> <Hyperlink NavigateUri="https://db-ip.com" RequestNavigate="OnRequestNavigate">DB-IP</Hyperlink><Run Text=" (CC BY 4.0)." />
      </TextBlock>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="You have unsaved changes" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"
                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="Discard" Command="{Binding DiscardCommand}" IsEnabled="{Binding IsDirty}" />
        <Button Content="Save changes" Command="{Binding SaveCommand}" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" IsEnabled="{Binding IsDirty}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
