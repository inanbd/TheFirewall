<UserControl x:Class="TheFirewall.App.Views.Pages.FeedsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TheFirewall.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:FeedsViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,16,32,32">
      <Grid>
        <StackPanel>
          <TextBlock Text="Threat feeds" Style="{StaticResource PageTitle}" />
          <TextBlock Style="{StaticResource PageSubtitle}" MaxWidth="680" HorizontalAlignment="Left"
                     Text="Block known attackers before they even try. Feeds are public lists of malicious addresses that TheFirewall downloads and keeps up to date." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button Command="{Binding RefreshNowCommand}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="14" />
              <TextBlock Text="Refresh now" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding AddCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
              <TextBlock Text="Add a feed" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Border Style="{StaticResource InfoBar}" Margin="0,16,0,16">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
          <TextBlock Margin="10,0,0,0" Style="{StaticResource Body}" MaxWidth="760"
                     Text="Feeds can contain mistakes. Whitelisted and local addresses are always excluded. A feed is any http(s) URL that returns one address, CIDR block or range per line." />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding LoadError}" Style="{StaticResource Caption}" Visibility="{Binding LoadError, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8" />

      <ItemsControl ItemsSource="{Binding Feeds}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:FeedItem}">
            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                          Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Feed.Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Feed.Url}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  <TextBlock Text="{Binding StatusText}" Margin="0,2,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SubtleButton}" ToolTip="Remove" AutomationProperties.Name="Remove" VerticalAlignment="Center"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                  <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="14" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
