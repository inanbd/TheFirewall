<UserControl x:Class="TheFirewall.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TheFirewall.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
  <UserControl.Resources>
    <!-- A setting row: title + description on the left, control on the right -->
    <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="90" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="DurationEditor" DataType="{x:Type vm:DurationField}">
      <StackPanel Orientation="Horizontal">
        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                 IsEnabled="{Binding Permanent, Converter={StaticResource InverseBoolean}}" />
        <ComboBox ItemsSource="{x:Static vm:DurationField.Units}" SelectedItem="{Binding Unit}" Width="110" Margin="6,0,0,0"
                  IsEnabled="{Binding Permanent, Converter={StaticResource InverseBoolean}}" />
        <CheckBox Content="Permanent" IsChecked="{Binding Permanent}" Margin="12,0,0,0" VerticalAlignment="Center"
                  Visibility="{Binding AllowPermanent, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="32,16,32,24" MaxWidth="1000">
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding LoadError}" Style="{StaticResource Caption}" Visibility="{Binding LoadError, Converter={StaticResource NullToVisibility}}" Margin="0,8,0,0" />

        <!-- ============================================================ Ban policy -->
        <TextBlock Text="When to ban" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,120,0">
              <TextBlock Text="Failed logins before a ban" Style="{StaticResource RowTitle}" />
              <TextBlock Text="An address is banned once it fails this many times. Individual monitors can override this." Style="{StaticResource RowHint}" />
            </StackPanel>
            <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding FailedAttemptsBeforeBan, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,280,0">
              <TextBlock Text="Forget failed logins after" Style="{StaticResource RowTitle}" />
              <TextBlock Text="If an address stays quiet this long, its failed login count starts again from zero." Style="{StaticResource RowHint}" />
            </StackPanel>
            <ContentControl HorizontalAlignment="Right" VerticalAlignment="Center" Content="{Binding FailedAttemptWindow}" ContentTemplate="{StaticResource DurationEditor}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <StackPanel>
            <Grid>
              <StackPanel Margin="0,0,160,0">
                <TextBlock Text="Ban duration" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Repeat offenders get the next, longer duration each time they are banned again." Style="{StaticResource RowHint}" />
              </StackPanel>
              <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Add a longer step" Command="{Binding AddBanDurationCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding BanDurations}" Margin="0,12,0,0" AlternationCount="100">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DurationField}">
                  <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Width="110" VerticalAlignment="Center" Style="{StaticResource Caption}">
                      <Run Text="Ban #" /><Run Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=OneWay, Converter={x:Static vm:PlusOneConverter.Instance}}" />
                    </TextBlock>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DurationEditor}" />
                    <Button Style="{StaticResource SubtleButton}" Margin="8,0,0,0" ToolTip="Remove this step" AutomationProperties.Name="Remove step"
                            Command="{Binding DataContext.RemoveBanDurationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                      <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,280,0">
              <TextBlock Text="Remember repeat offenders for" Style="{StaticResource RowTitle}" />
              <TextBlock Text="After this long without new attempts an address starts again at the first ban duration." Style="{StaticResource RowHint}" />
            </StackPanel>
            <ContentControl HorizontalAlignment="Right" VerticalAlignment="Center" Content="{Binding RepeatOffenderMemory}" ContentTemplate="{StaticResource DurationEditor}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,120,0">
              <TextBlock Text="Seconds between counted attempts" Style="{StaticResource RowTitle}" />
              <TextBlock Text="Several log entries for the same attempt within this time count only once." Style="{StaticResource RowHint}" />
            </StackPanel>
            <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding MinimumSecondsBetweenAttempts, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,80,0">
              <TextBlock Text="Start counting from zero after a ban ends" Style="{StaticResource RowTitle}" />
              <TextBlock Text="When off, the next failed login after a ban immediately bans the address again (for longer)." Style="{StaticResource RowHint}" />
            </StackPanel>
            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ResetFailedAttemptsAfterUnban}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,80,0">
              <TextBlock Text="Reset the count after a successful sign-in" Style="{StaticResource RowTitle}" />
              <TextBlock Text="Forgive a few typos once the person signs in correctly." Style="{StaticResource RowHint}" />
            </StackPanel>
            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ClearFailedAttemptsOnSuccessfulLogin}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,80,0">
              <TextBlock Text="Also ban local network addresses" Style="{StaticResource RowTitle}" />
              <TextBlock Text="Off by default so you cannot lock out machines on your own network (10.x, 172.16-31.x, 192.168.x...)." Style="{StaticResource RowHint}" />
            </StackPanel>
            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ProcessInternalAddresses}" />
          </Grid>
        </Border>

        <!-- ============================================================ User names -->
        <TextBlock Text="User names" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Instant-ban user names" Style="{StaticResource RowTitle}" />
              <TextBlock Text="Anyone trying one of these is banned on the first attempt. One per line, e.g. admin, root, test." Style="{StaticResource RowHint}" />
              <TextBox Text="{Binding InstantBanUserNames, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="96" Margin="0,8,0,0"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
              <TextBlock Text="Your real user names" Style="{StaticResource RowTitle}" />
              <TextBlock Text="People mistyping a known name get more attempts (below). One per line." Style="{StaticResource RowHint}" />
              <TextBox Text="{Binding AllowedUserNames, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="96" Margin="0,8,0,0"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,120,0">
              <TextBlock Text="Failed logins allowed for real user names" Style="{StaticResource RowTitle}" />
              <TextBlock Text="Only used when the list of real user names is not empty." Style="{StaticResource RowHint}" />
            </StackPanel>
            <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding FailedAttemptsBeforeBanForAllowedUserNames, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,120,0">
              <TextBlock Text="Typos allowed in a real user name" Style="{StaticResource RowTitle}" />
              <TextBlock Text="&quot;adminstrator&quot; is one typo away from &quot;administrator&quot;." Style="{StaticResource RowHint}" />
            </StackPanel>
            <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding AllowedUserNameEditDistance, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,80,0">
              <TextBlock Text="Ban any other user name immediately" Style="{StaticResource RowTitle}" />
              <TextBlock Text="Strict mode: anyone trying a name that is not on your list is banned on the first attempt." Style="{StaticResource RowHint}" />
            </StackPanel>
            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding BanUnknownUserNamesImmediately}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,120,0">
              <TextBlock Text="Cut user names at" Style="{StaticResource RowTitle}" />
              <TextBlock Text="&quot;@&quot; turns bob@contoso.com into bob, so attackers cycling domains are counted as one name." Style="{StaticResource RowHint}" />
            </StackPanel>
            <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" HorizontalContentAlignment="Left" Text="{Binding TruncateUserNameChars, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>

        <!-- ============================================================ Notifications -->
        <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
        <Border Style="{StaticResource SettingRow}">
          <StackPanel>
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyOnBan}" Content="Show a notification when an address is banned" />
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyOnUnban}" Content="Show a notification when an address is unbanned" Margin="0,10,0,0" />
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyOnSuccessfulLogin}" Content="Show a notification for successful remote sign-ins" Margin="0,10,0,0" />
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyOnServiceProblems}" Content="Warn me when the service stops" Margin="0,10,0,0" />
          </StackPanel>
        </Border>

        <!-- ============================================================ This computer -->
        <TextBlock Text="This computer" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,200,0">
              <TextBlock Text="App theme" Style="{StaticResource RowTitle}" />
              <TextBlock Text="Follow Windows, or always use light or dark." Style="{StaticResource RowHint}" />
            </StackPanel>
            <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="160" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,80,0">
              <TextBlock Text="Show the tray icon when an administrator signs in" Style="{StaticResource RowTitle}" />
              <TextBlock Text="Starts with full rights and no UAC prompt. The protection service runs either way." Style="{StaticResource RowHint}" />
            </StackPanel>
            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding TrayAtSignIn}"
                      Command="{Binding ToggleTrayAtSignInCommand}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,380,0">
              <TextBlock Style="{StaticResource RowTitle}"><Run Text="TheFirewall service: " /><Run Text="{Binding ServiceStateText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
              <TextBlock Text="The background service does the actual work; it keeps running when this window or the tray icon is closed." Style="{StaticResource RowHint}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Content="Start" Command="{Binding ServiceActionCommand}" CommandParameter="start" />
              <Button Content="Stop" Command="{Binding ServiceActionCommand}" CommandParameter="stop" Margin="6,0,0,0" />
              <Button Content="Restart" Command="{Binding ServiceActionCommand}" CommandParameter="restart" Margin="6,0,0,0" />
              <Button Content="Install" Command="{Binding ServiceActionCommand}" CommandParameter="install" Margin="6,0,0,0" />
              <Button Content="Uninstall" Command="{Binding ServiceActionCommand}" CommandParameter="uninstall" Margin="6,0,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <Grid>
            <StackPanel Margin="0,0,300,0">
              <TextBlock Text="Backup" Style="{StaticResource RowTitle}" />
              <TextBlock Text="Save all settings and the ban list to a file, or restore them on another server." Style="{StaticResource RowHint}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Command="{Binding ExportCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="14" />
                  <TextBlock Text="Export…" Margin="8,0,0,0" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ImportCommand}" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="14" />
                  <TextBlock Text="Import…" Margin="8,0,0,0" />
                </StackPanel>
              </Button>
              <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="6,0,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ============================================================ Advanced -->
        <Expander Header="Advanced" Margin="0,24,0,0">
          <StackPanel Margin="0,8,0,0">
            <Border Style="{StaticResource SettingRow}">
              <StackPanel>
                <TextBlock Text="Run a program" Style="{StaticResource RowTitle}" />
                <TextBlock Style="{StaticResource RowHint}"
                           Text="For alerts or integrations. Example: &quot;C:\Scripts\notify.exe&quot; --ip {ip} --user {user}. Placeholders: {ip} {user} {source} {country} {count} {reason} {duration} {log}. One command per line." />
                <TextBlock Text="When an address is banned" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding RunOnBan, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" />
                <TextBlock Text="When an address is unbanned" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding RunOnUnban, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" />
                <TextBlock Text="When someone signs in successfully" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding RunOnSuccessfulLogin, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <StackPanel Margin="0,0,220,0">
                  <TextBlock Text="Firewall rule name prefix" Style="{StaticResource RowTitle}" />
                  <TextBlock Text="Every Windows Firewall rule whose name starts with this prefix is managed by TheFirewall." Style="{StaticResource RowHint}" />
                </StackPanel>
                <TextBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="200" Text="{Binding FirewallRulePrefix, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <StackPanel Margin="0,0,120,0">
                  <TextBlock Text="Housekeeping interval (seconds)" Style="{StaticResource RowTitle}" />
                  <TextBlock Text="How often expired bans are lifted. New bans are applied immediately." Style="{StaticResource RowHint}" />
                </StackPanel>
                <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding CycleSeconds, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <StackPanel Margin="0,0,120,0">
                  <TextBlock Text="Keep activity history for (days)" Style="{StaticResource RowTitle}" />
                  <TextBlock Text="Older entries are removed from the activity feed and charts." Style="{StaticResource RowHint}" />
                </StackPanel>
                <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding ActivityRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <StackPanel Margin="0,0,80,0">
                  <TextBlock Text="Turn on failed-logon auditing automatically" Style="{StaticResource RowTitle}" />
                  <TextBlock Text="Windows only logs failed RDP/SMB logons (event 4625) when this audit policy is on." Style="{StaticResource RowHint}" />
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding EnsureLogonFailureAuditing}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <StackPanel Margin="0,0,80,0">
                  <TextBlock Text="Open every port to whitelisted addresses" Style="{StaticResource RowTitle}" />
                  <TextBlock Text="Creates an allow rule for the whitelist. Only useful if Windows Firewall blocks inbound traffic you need from them." Style="{StaticResource RowHint}" />
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding WhitelistOpensAllPorts}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <StackPanel Margin="0,0,80,0">
                  <TextBlock Text="Clear all bans when the service starts" Style="{StaticResource RowTitle}" />
                  <TextBlock Text="Normally bans survive restarts." Style="{StaticResource RowHint}" />
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ClearBansOnStartup}" />
              </Grid>
            </Border>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <!-- Save bar -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="32,12"
            Background="{DynamicResource LayerFillColorAltBrush}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Discard changes" Command="{Binding DiscardCommand}" />
        <Button Content="Save changes" Command="{Binding SaveCommand}" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" MinWidth="120" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
