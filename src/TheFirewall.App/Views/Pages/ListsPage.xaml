<UserControl x:Class="TheFirewall.App.Views.Pages.ListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TheFirewall.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ListsViewModel}">
  <UserControl.Resources>
    <DataTemplate x:Key="AddedCell">
      <TextBlock Text="{Binding AddedUtc, Converter={StaticResource RelativeTime}}" ToolTip="{Binding AddedUtc, Converter={StaticResource LocalTime}}" VerticalAlignment="Center" />
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="32,16,32,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Allow &amp; block lists" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Addresses that must never be banned, and addresses that are always blocked. Entries can be single addresses, CIDR blocks (10.0.0.0/8), ranges (1.2.3.4-1.2.3.99) or wildcards (192.168.1.*)."
                 Style="{StaticResource PageSubtitle}" MaxWidth="760" HorizontalAlignment="Left" />
    </StackPanel>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
      <TabItem>
        <TabItem.Header>
          <TextBlock><Run Text="Whitelist - never ban" /> <Run Text="{Binding Whitelist.Count, Mode=OneWay, StringFormat=({0})}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
        </TabItem.Header>
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,10">
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left"
                       Text="Add your office, home and monitoring addresses here so a few mistyped passwords never lock you out. Local network addresses are never banned anyway." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Command="{Binding AddWhitelistCommand}" Style="{DynamicResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                  <TextBlock Text="Add" Margin="8,0,0,0" />
                </StackPanel>
              </Button>
              <Button Margin="8,0,0,0" Command="{Binding RemoveWhitelistCommand}" CommandParameter="{Binding SelectedItems, ElementName=WhiteGrid}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="14" />
                  <TextBlock Text="Remove" Margin="8,0,0,0" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0">
            <Grid>
              <DataGrid x:Name="WhiteGrid" Style="{StaticResource ListGrid}" ItemsSource="{Binding Whitelist}">
                <DataGrid.Columns>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Address" Binding="{Binding Value}" Width="240" FontFamily="Cascadia Mono, Consolas" />
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Comment" Binding="{Binding Comment}" Width="*" />
                  <DataGridTemplateColumn Header="Added" Width="130" CellTemplate="{StaticResource AddedCell}" SortMemberPath="AddedUtc" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="The whitelist is empty." Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding Whitelist.Count, Converter={StaticResource ZeroToVisibility}}" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <TextBlock><Run Text="Blacklist - always block" /> <Run Text="{Binding Blacklist.Count, Mode=OneWay, StringFormat=({0})}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
        </TabItem.Header>
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,10">
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left"
                       Text="These addresses are blocked on every port, all the time. The whitelist wins if an address is on both lists." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Command="{Binding AddBlacklistCommand}" Style="{DynamicResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                  <TextBlock Text="Add" Margin="8,0,0,0" />
                </StackPanel>
              </Button>
              <Button Margin="8,0,0,0" Command="{Binding RemoveBlacklistCommand}" CommandParameter="{Binding SelectedItems, ElementName=BlackGrid}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="14" />
                  <TextBlock Text="Remove" Margin="8,0,0,0" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0">
            <Grid>
              <DataGrid x:Name="BlackGrid" Style="{StaticResource ListGrid}" ItemsSource="{Binding Blacklist}">
                <DataGrid.Columns>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Address" Binding="{Binding Value}" Width="240" FontFamily="Cascadia Mono, Consolas" />
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Comment" Binding="{Binding Comment}" Width="*" />
                  <DataGridTemplateColumn Header="Added" Width="130" CellTemplate="{StaticResource AddedCell}" SortMemberPath="AddedUtc" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="The blacklist is empty." Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding Blacklist.Count, Converter={StaticResource ZeroToVisibility}}" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Patterns (advanced)">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,0,0" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Caption}"
                       Text="Regular expressions for special cases. Use * as a shortcut for 'anything', e.g. 10.20.*. Leave empty when not needed." />
            <TextBlock Text="Never ban addresses matching" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding WhitelistRegex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" />
            <TextBlock Text="Ban immediately when the address or user name matches" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding BlacklistRegex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" />
            <Button Content="Save patterns" Command="{Binding SavePatternsCommand}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,16,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
