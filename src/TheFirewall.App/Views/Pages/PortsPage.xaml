<UserControl x:Class="TheFirewall.App.Views.Pages.PortsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TheFirewall.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PortsViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,16,32,32">
      <Grid>
        <StackPanel Margin="0,0,160,0">
          <TextBlock Text="Ports" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Open or close ports, choose who may connect to each one, and open them only when you need them."
                     Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource AccentButtonStyle}" Command="{Binding AddCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <TextBlock Text="Add a port" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Quick add -->
      <DockPanel Margin="0,16,0,12">
        <TextBlock Text="Common ports:" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="0,7,8,0" DockPanel.Dock="Left" />
        <ItemsControl ItemsSource="{Binding QuickAdd}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Name}" Margin="0,0,8,8" ToolTip="{Binding Ports}"
                      Command="{Binding DataContext.AddKnownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>

      <Border Style="{StaticResource InfoBar}" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
          <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Body}" TextWrapping="Wrap"
                     Text="Closing or restricting a port never blocks addresses on your whitelist or your local network, so you can't lock yourself out from them. Bans and blocked countries still apply to open ports." />
        </Grid>
      </Border>

      <!-- Managed ports -->
      <ItemsControl ItemsSource="{Binding Ports}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PortItem}">
            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StateExposure, Converter={StaticResource PortExposureGlyph}}" Style="{StaticResource Glyph}" FontSize="18"
                           Foreground="{Binding StateExposure, Converter={StaticResource PortExposureBrush}}" VerticalAlignment="Top" Margin="0,2,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Style="{StaticResource Body}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding PortText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </TextBlock>
                  <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                             Foreground="{Binding StateExposure, Converter={StaticResource PortExposureBrush}}" />
                  <TextBlock Text="{Binding ScheduleText}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                             Visibility="{Binding ScheduleText, Converter={StaticResource NullToVisibility}}" />
                  <TextBlock Text="{Binding UsageText}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource SegmentBar}" ToolTip="Who may connect to this port">
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SegmentButton}" Content="Open" Tag="{Binding IsOpen}"
                            Command="{Binding SetAccessCommand}" CommandParameter="Everyone" ToolTip="Anyone may connect" />
                    <Button Style="{StaticResource SegmentButton}" Content="Only some" Tag="{Binding IsRestricted}"
                            Command="{Binding SetAccessCommand}" CommandParameter="Restricted" ToolTip="Only the addresses and countries you choose" />
                    <Button Style="{StaticResource SegmentButton}" Content="Closed" Tag="{Binding IsClosed}"
                            Command="{Binding SetAccessCommand}" CommandParameter="Nobody" ToolTip="Block everyone except your whitelist and local network" />
                  </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Button Style="{StaticResource SubtleButton}" ToolTip="Open to everyone for a while" AutomationProperties.Name="Open for a while"
                          Click="OnOpenForClick">
                    <TextBlock Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="14" />
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Open to everyone for 30 minutes" Command="{Binding OpenForCommand}" CommandParameter="30" />
                        <MenuItem Header="Open to everyone for 1 hour" Command="{Binding OpenForCommand}" CommandParameter="60" />
                        <MenuItem Header="Open to everyone for 2 hours" Command="{Binding OpenForCommand}" CommandParameter="120" />
                        <MenuItem Header="Open to everyone for 4 hours" Command="{Binding OpenForCommand}" CommandParameter="240" />
                        <MenuItem Header="Open to everyone for 8 hours" Command="{Binding OpenForCommand}" CommandParameter="480" />
                        <MenuItem Header="Open to everyone for 1 day" Command="{Binding OpenForCommand}" CommandParameter="1440" />
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                  <Button Style="{StaticResource SubtleButton}" ToolTip="End the temporary opening now" AutomationProperties.Name="End temporary opening"
                          Command="{Binding CloseNowCommand}" Visibility="{Binding IsTemporarilyOpen, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE71A;" Style="{StaticResource Glyph}" FontSize="14" />
                  </Button>
                  <Button Style="{StaticResource SubtleButton}" ToolTip="Edit" AutomationProperties.Name="Edit" Command="{Binding EditCommand}">
                    <TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" FontSize="14" />
                  </Button>
                  <Button Style="{StaticResource SubtleButton}" ToolTip="Stop managing this port" AutomationProperties.Name="Remove" Command="{Binding DeleteCommand}">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="14" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Card}" Padding="24" Visibility="{Binding Ports.Count, Converter={StaticResource ZeroToVisibility}}">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="&#xE839;" Style="{StaticResource Glyph}" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Text="No ports managed yet" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
          <TextBlock Text="{Binding LoadError, TargetNullValue='Add a common port above, or choose Close or Manage next to a port in the list below.'}"
                     Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
        </StackPanel>
      </Border>

      <!-- Listening ports -->
      <Grid Margin="0,28,0,0">
        <StackPanel Margin="0,0,140,0">
          <TextBlock Text="Listening on this computer" Style="{StaticResource SectionTitle}" Margin="0" />
          <TextBlock Text="Programs that accept incoming connections, and whether other computers can reach them."
                     Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding RescanCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="14" />
            <TextBlock Text="Check again" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </Grid>

      <TextBlock Text="{Binding ListeningError}" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding ListeningError, Converter={StaticResource NullToVisibility}}" />

      <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
        <StackPanel>
          <Grid Margin="16,10" TextElement.FontWeight="SemiBold">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="64" />
              <ColumnDefinition Width="52" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Port" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Program" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Who can reach it" Style="{StaticResource Caption}" FontWeight="SemiBold" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Listening}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ListeningPortItem}">
                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition Width="52" />
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition Width="3*" />
                      <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PortText}" Style="{StaticResource Mono}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Protocol}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding ProgramToolTip}">
                      <TextBlock Text="{Binding ProgramText}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding UseText, Mode=OneWay}" />
                        <Run Text="{Binding AddressText, Mode=OneWay, StringFormat='· {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                      </TextBlock>
                    </StackPanel>
                    <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Exposure, Converter={StaticResource PortExposureGlyph}}" Style="{StaticResource Glyph}" FontSize="14"
                                 Foreground="{Binding Exposure, Converter={StaticResource PortExposureBrush}}" VerticalAlignment="Top" Margin="0,2,8,0" />
                      <TextBlock Grid.Column="1" Text="{Binding ExposureText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button Content="Close" Command="{Binding CloseCommand}" Margin="0,0,8,0" ToolTip="Block everyone except your whitelist and local network"
                              Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}" />
                      <Button Content="Manage…" Command="{Binding ManageCommand}" ToolTip="Choose who may connect to this port" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Checking which ports are in use…" Style="{StaticResource Caption}" Margin="16,8,16,12"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
