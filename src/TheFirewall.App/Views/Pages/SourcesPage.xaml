<UserControl x:Class="TheFirewall.App.Views.Pages.SourcesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TheFirewall.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SourcesViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,16,32,32">
      <Grid>
        <StackPanel>
          <TextBlock Text="Login monitors" Style="{StaticResource PageTitle}" />
          <TextBlock Style="{StaticResource PageSubtitle}" MaxWidth="680" HorizontalAlignment="Left"
                     Text="TheFirewall reads these Windows event logs and log files to spot failed sign-ins. Monitors for software that isn't installed simply wait, so it's safe to leave them on." />
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource AccentButtonStyle}" Command="{Binding AddCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <TextBlock Text="Add custom monitor" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </Grid>

      <Grid Margin="0,16,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" VerticalContentAlignment="Center" />
          <TextBlock Text="Find a monitor…" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center"
                     Style="{StaticResource Caption}" Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
        </Grid>
        <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Style="{StaticResource Caption}">
          <Run Text="{Binding ActiveCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" monitors are actively watching on this computer." />
        </TextBlock>
        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" Content="Only show active monitors" IsChecked="{Binding OnlyDetected}" VerticalAlignment="Center" />
      </Grid>

      <TextBlock Text="{Binding LoadError}" Style="{StaticResource Caption}" Visibility="{Binding LoadError, Converter={StaticResource NullToVisibility}}" Margin="0,8" />

      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:SourceGroup}">
            <StackPanel Margin="0,16,0,0">
              <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:SourceItem}">
                    <Border Style="{StaticResource SettingRow}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                  Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="11" Margin="8,0,0,0" ToolTip="Reports successful sign-ins"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       Visibility="{Binding IsSuccessSource, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>
                          <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                          <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                          <TextBlock Text="{Binding Statistics}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                     Visibility="{Binding Statistics, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="0,0,12,0" ToolTip="{Binding StatusMessage}">
                          <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding State, Converter={StaticResource SourceStateBrush}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding State, Converter={StaticResource SourceStateText}}" Margin="6,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                          </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Style="{StaticResource SubtleButton}" ToolTip="Details and settings" AutomationProperties.Name="Details"
                                  Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" FontSize="14" />
                          </Button>
                          <Button Style="{StaticResource SubtleButton}" ToolTip="Copy as a custom monitor" AutomationProperties.Name="Duplicate"
                                  Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="14" />
                          </Button>
                          <Button Style="{StaticResource SubtleButton}" ToolTip="Delete" AutomationProperties.Name="Delete"
                                  Visibility="{Binding IsBuiltIn, Converter={StaticResource InverseBoolToVisibility}}"
                                  Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="14" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
