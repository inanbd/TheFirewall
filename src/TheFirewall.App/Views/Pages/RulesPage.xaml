<UserControl x:Class="TheFirewall.App.Views.Pages.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TheFirewall.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RulesViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,16,32,32">
      <Grid>
        <StackPanel>
          <TextBlock Text="Firewall rules" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Your own allow and block rules. TheFirewall creates them in Windows Defender Firewall (group &quot;TheFirewall&quot;) and keeps them in sync."
                     Style="{StaticResource PageSubtitle}" MaxWidth="640" HorizontalAlignment="Left" />
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource AccentButtonStyle}" Command="{Binding AddCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <TextBlock Text="New rule" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </Grid>

      <StackPanel Orientation="Horizontal" Margin="0,16,0,16">
        <TextBlock Text="Quick start:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Content="Allow a port only from trusted addresses" Command="{Binding AddCommand}" CommandParameter="allow-port" />
        <Button Content="Block a port" Command="{Binding AddCommand}" CommandParameter="block-port" Margin="8,0,0,0" />
        <Button Content="Block addresses" Command="{Binding AddCommand}" CommandParameter="block-address" Margin="8,0,0,0" />
      </StackPanel>

      <Border Style="{StaticResource InfoBar}" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
          <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Body}"
                     Text="In Windows Firewall a block rule always wins over an allow rule. To limit a service to certain addresses, create an allow rule for those addresses and make sure no other rule opens the port to everyone." />
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Rules}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:RuleItem}">
            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="Turn this rule on or off"
                          Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                <Border Grid.Column="1" Margin="16,0,0,0" Width="58" CornerRadius="4" Padding="0,3" VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAllow}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding ActionText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsAllow}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
                <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                             Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource SubtleButton}" ToolTip="Edit" AutomationProperties.Name="Edit"
                          Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" FontSize="14" />
                  </Button>
                  <Button Style="{StaticResource SubtleButton}" ToolTip="Duplicate" AutomationProperties.Name="Duplicate"
                          Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="14" />
                  </Button>
                  <Button Style="{StaticResource SubtleButton}" ToolTip="Delete" AutomationProperties.Name="Delete"
                          Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="14" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Card}" Padding="24" Visibility="{Binding Rules.Count, Converter={StaticResource ZeroToVisibility}}">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Text="No custom rules yet" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
          <TextBlock Text="{Binding LoadError, TargetNullValue='Bans are handled automatically. Add a rule here when you want to open or close a port yourself.'}"
                     Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
