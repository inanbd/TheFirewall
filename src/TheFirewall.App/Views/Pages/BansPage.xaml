<UserControl x:Class="TheFirewall.App.Views.Pages.BansPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TheFirewall.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:BansViewModel}">
  <UserControl.Resources>
    <DataTemplate x:Key="AddressCell">
      <TextBlock Text="{Binding IPAddress}" Style="{StaticResource Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding IPAddress}" />
    </DataTemplate>

    <!-- Right-click menu for both grids; the commands take the grid's selected rows. -->
    <ContextMenu x:Key="RowMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Show details" Command="{Binding ShowDetailsCommand}"
                CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
      <Separator />
      <MenuItem Header="Ban forever" Command="{Binding BanForeverCommand}"
                CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
      <MenuItem Header="Never ban (whitelist)" Command="{Binding UnbanAndWhitelistCommand}"
                CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
      <Separator />
      <MenuItem Header="{Binding PlacementTarget.SelectedItem.Country, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource CountryName}, ConverterParameter='Block every address from {0}', FallbackValue='Block every address from this country'}"
                Command="{Binding BlockCountryCommand}"
                CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE733;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </UserControl.Resources>

  <Grid Margin="32,16,32,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Banned addresses" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Addresses that are blocked right now, and addresses with failed logins that TheFirewall is keeping an eye on."
                 Style="{StaticResource PageSubtitle}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,16,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MaxWidth="320" />
        <ColumnDefinition Width="*" MinWidth="8" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" VerticalContentAlignment="Center" />
        <TextBlock Text="Filter by address, country, user…" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Style="{StaticResource Caption}" Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
      </Grid>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Command="{Binding BanAddressCommand}" Style="{DynamicResource AccentButtonStyle}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <TextBlock Text="Ban an address" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ExportCommand}" Margin="8,0,0,0" ToolTip="Export as CSV">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="14" />
            <TextBlock Text="Export" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}">
      <TabItem>
        <TabItem.Header>
          <TextBlock>
            <Run Text="Banned" /> <Run Text="{Binding Banned.Count, Mode=OneWay, StringFormat=({0:N0})}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </TextBlock>
        </TabItem.Header>
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Command="{Binding UnbanCommand}" CommandParameter="{Binding SelectedItems, ElementName=BannedGrid}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE785;" Style="{StaticResource Glyph}" FontSize="14" />
                <TextBlock Text="Unban" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Margin="8,0,0,0" Command="{Binding UnbanAndWhitelistCommand}" CommandParameter="{Binding SelectedItems, ElementName=BannedGrid}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="14" />
                <TextBlock Text="Unban and never ban again" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Margin="8,0,0,0" Command="{Binding BanForeverCommand}" CommandParameter="{Binding SelectedItems, ElementName=BannedGrid}"
                    ToolTip="Keep the selected addresses blocked permanently instead of until their ban ends">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="14" />
                <TextBlock Text="Ban forever" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Margin="8,0,0,0" Command="{Binding BlockCountryCommand}" CommandParameter="{Binding SelectedItems, ElementName=BannedGrid}"
                    ToolTip="Block every address from the countries of the selected addresses, not only the ones that tried to sign in">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE733;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <TextBlock Text="Block country" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Margin="8,0,0,0" Style="{StaticResource SubtleButton}" Command="{Binding ClearAllCommand}" Foreground="{DynamicResource SystemFillColorCriticalBrush}">
              <TextBlock Text="Unban everyone…" />
            </Button>
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0">
            <Grid>
              <DataGrid x:Name="BannedGrid" Style="{StaticResource ListGrid}" ItemsSource="{Binding BannedView}" ContextMenu="{StaticResource RowMenu}">
                <DataGrid.InputBindings>
                  <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ShowDetailsCommand}" CommandParameter="{Binding SelectedItem, ElementName=BannedGrid}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Address" Width="170" MinWidth="170" SortMemberPath="IPAddress" CellTemplate="{StaticResource AddressCell}" />
                  <DataGridTemplateColumn Header="Country" Width="165" MinWidth="165" SortMemberPath="Country" CellTemplate="{StaticResource CountryCell}" />
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Source" Binding="{Binding Source}" Width="95" MinWidth="95" />
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="User names tried" Binding="{Binding UserNames}" Width="130" MinWidth="130" />
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Tries" Binding="{Binding FailedCount}" Width="70" MinWidth="70" />
                  <DataGridTemplateColumn Header="Banned" Width="95" MinWidth="95" SortMemberPath="BanStartUtc">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding BanStartUtc, Converter={StaticResource RelativeTime}}" VerticalAlignment="Center"
                                   ToolTip="{Binding BanStartUtc, Converter={StaticResource LocalTime}}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Ends" Width="95" MinWidth="95" SortMemberPath="BanEndUtc">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding BanEndUtc, Converter={StaticResource Expiry}}" VerticalAlignment="Center"
                                   ToolTip="{Binding BanEndUtc, Converter={StaticResource LocalTime}}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Reason" Binding="{Binding BanReason}" Width="*" MinWidth="120" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Banned.Count, Converter={StaticResource ZeroToVisibility}}">
                <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No one is banned" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="{Binding LoadError, TargetNullValue='Addresses appear here when they exceed the failed login limit.'}"
                           Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <TextBlock>
            <Run Text="Watching" /> <Run Text="{Binding Watched.Count, Mode=OneWay, StringFormat=({0:N0})}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </TextBlock>
        </TabItem.Header>
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Command="{Binding BanSelectedCommand}" CommandParameter="{Binding SelectedItems, ElementName=WatchedGrid}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="14" />
                <TextBlock Text="Ban now" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Margin="8,0,0,0" Command="{Binding BanForeverCommand}" CommandParameter="{Binding SelectedItems, ElementName=WatchedGrid}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="14" />
                <TextBlock Text="Ban forever" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Margin="8,0,0,0" Command="{Binding UnbanAndWhitelistCommand}" CommandParameter="{Binding SelectedItems, ElementName=WatchedGrid}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="14" />
                <TextBlock Text="Never ban (whitelist)" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Margin="8,0,0,0" Command="{Binding BlockCountryCommand}" CommandParameter="{Binding SelectedItems, ElementName=WatchedGrid}"
                    ToolTip="Block every address from the countries of the selected addresses, not only the ones that tried to sign in">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE733;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <TextBlock Text="Block country" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0">
            <Grid>
              <DataGrid x:Name="WatchedGrid" Style="{StaticResource ListGrid}" ItemsSource="{Binding WatchedView}" ContextMenu="{StaticResource RowMenu}">
                <DataGrid.InputBindings>
                  <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ShowDetailsCommand}" CommandParameter="{Binding SelectedItem, ElementName=WatchedGrid}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Address" Width="170" MinWidth="170" SortMemberPath="IPAddress" CellTemplate="{StaticResource AddressCell}" />
                  <DataGridTemplateColumn Header="Country" Width="165" MinWidth="165" SortMemberPath="Country" CellTemplate="{StaticResource CountryCell}" />
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Source" Binding="{Binding Source}" Width="95" MinWidth="95" />
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="User names tried" Binding="{Binding UserNames}" Width="*" />
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Failed attempts" Binding="{Binding FailedCount}" Width="110" MinWidth="110" />
                  <DataGridTemplateColumn Header="Last attempt" Width="120" MinWidth="120" SortMemberPath="LastFailedUtc">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding LastFailedUtc, Converter={StaticResource RelativeTime}}" VerticalAlignment="Center"
                                   ToolTip="{Binding LastFailedUtc, Converter={StaticResource LocalTime}}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Watched.Count, Converter={StaticResource ZeroToVisibility}}">
                <TextBlock Text="Nobody is being watched" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="Addresses with a few failed logins (below the ban limit) are listed here." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
