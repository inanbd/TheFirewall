<Window x:Class="TheFirewall.App.Views.Dialogs.AddressDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:TheFirewall.App.Controls"
        Title="Address details" Width="720" Height="640" MinWidth="660" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24,20,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <ctl:CountryFlag x:Name="Flag" FlagWidth="32" Margin="0,0,12,0" />
      <TextBlock x:Name="AddressText" FontSize="24" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <Button Style="{StaticResource SubtleButton}" Click="OnCopy" Margin="8,0,0,0" Padding="8" VerticalAlignment="Center" ToolTip="Copy address"
              AutomationProperties.Name="Copy address">
        <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="14" />
      </Button>
    </StackPanel>
    <TextBlock x:Name="CountryText" Grid.Row="1" Style="{StaticResource Caption}" Margin="0,4,0,0" />

    <Border x:Name="StatusBar" Grid.Row="2" Style="{StaticResource InfoBar}" Margin="0,16,0,12">
      <StackPanel>
        <TextBlock x:Name="StatusTitle" Style="{StaticResource Body}" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusDetail" Style="{StaticResource Caption}" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4" Margin="0">
      <Grid>
      <TextBlock x:Name="EmptyText" Text="No activity recorded for this address." Style="{StaticResource Caption}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
      <DataGrid x:Name="ActivityGrid" Style="{StaticResource ListGrid}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Time" Width="140" MinWidth="140">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding TimeUtc, Converter={StaticResource LocalTime}, ConverterParameter=g}" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Event" Width="130" MinWidth="130">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Type, Converter={StaticResource ActivityGlyph}}" Style="{StaticResource Glyph}" FontSize="13"
                             Foreground="{Binding Type, Converter={StaticResource ActivityBrush}}" />
                  <TextBlock Text="{Binding Type, Converter={StaticResource ActivityText}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Source" Binding="{Binding Source}" Width="90" MinWidth="90" />
          <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="User" Binding="{Binding UserName}" Width="110" MinWidth="110" />
          <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Details" Binding="{Binding Message}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BanButton" Content="Ban" Click="OnBan" MinWidth="90" />
        <Button x:Name="BanForeverButton" Content="Ban forever" Click="OnBanForever" Margin="8,0,0,0" />
        <Button x:Name="UnbanButton" Content="Unban" Click="OnUnban" MinWidth="90" Margin="8,0,0,0" />
        <Button x:Name="WhitelistButton" Content="Never ban" Click="OnWhitelist" Margin="8,0,0,0" />
        <Button x:Name="BlockCountryButton" Content="Block country" Click="OnBlockCountry" Margin="8,0,0,0" IsEnabled="False" />
      </StackPanel>
      <Button Grid.Column="1" Content="Close" IsCancel="True" MinWidth="90" Margin="12,0,0,0" Click="OnClose" />
    </Grid>
  </Grid>
</Window>
