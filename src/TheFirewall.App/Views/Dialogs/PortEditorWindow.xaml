<Window x:Class="TheFirewall.App.Views.Dialogs.PortEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:TheFirewall.App.Controls"
        Title="Port" Width="640" Height="780" MinHeight="520" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,20,24,12">
        <TextBlock x:Name="HeaderText" Text="Add a port" Style="{StaticResource SectionTitle}" FontSize="20" />
        <Border Style="{StaticResource InfoBar}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock x:Name="PreviewText" Style="{StaticResource Body}" TextWrapping="Wrap" />
            <TextBlock x:Name="SituationText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" TextChanged="OnChanged" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Port or ports" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="PortsBox" TextChanged="OnChanged" FontFamily="Cascadia Mono, Consolas" />
            <TextBlock Text="e.g. 3389, or 80, 443, or 8000-8100" Style="{StaticResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Protocol" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ProtocolBox" SelectionChanged="OnChanged">
              <ComboBoxItem Content="TCP (most services)" Tag="Tcp" />
              <ComboBoxItem Content="UDP" Tag="Udp" />
              <ComboBoxItem Content="TCP and UDP" Tag="Any" />
            </ComboBox>
          </StackPanel>
        </Grid>

        <TextBlock Text="Who may connect" Style="{StaticResource FieldLabel}" Margin="0,20,0,6" />
        <RadioButton x:Name="AccessEveryone" GroupName="Access" Checked="OnChanged">
          <StackPanel>
            <TextBlock Text="Everyone (open)" Style="{StaticResource Body}" />
            <TextBlock Text="Any address may connect. Banned addresses and blocked countries are still kept out." Style="{StaticResource Caption}" TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="AccessRestricted" GroupName="Access" Margin="0,10,0,0" Checked="OnChanged">
          <StackPanel>
            <TextBlock Text="Only some addresses and countries" Style="{StaticResource Body}" />
            <TextBlock Text="Everyone else is blocked on this port." Style="{StaticResource Caption}" TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>

        <StackPanel x:Name="RestrictedPanel" Margin="28,8,0,0">
          <TextBlock Text="Addresses" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
          <TextBox x:Name="AddressesBox" AcceptsReturn="True" Height="76" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                   FontFamily="Cascadia Mono, Consolas" TextChanged="OnChanged" />
          <TextBlock Text="One per line or comma separated: addresses, CIDR blocks (203.0.113.0/24) or ranges." Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />

          <TextBlock Text="Countries" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CountryPicker" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="Name" TextSearch.TextPath="Name"
                      AutomationProperties.Name="Country to allow" />
            <Button Grid.Column="1" Content="Add country" Margin="8,0,0,0" Click="OnAddCountry" />
          </Grid>
          <ItemsControl x:Name="CountryList" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Pill}" Margin="0,0,6,6" Padding="8,2,2,2">
                  <StackPanel Orientation="Horizontal">
                    <ctl:CountryFlag Code="{Binding Code}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource SubtleButton}" Padding="6,2" Margin="4,0,0,0" Tag="{Binding Code}" Click="OnRemoveCountry"
                            ToolTip="Remove" AutomationProperties.Name="Remove country">
                      <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <RadioButton x:Name="AccessNobody" GroupName="Access" Margin="0,10,0,0" Checked="OnChanged">
          <StackPanel>
            <TextBlock Text="Nobody (closed)" Style="{StaticResource Body}" />
            <TextBlock Text="Everyone is blocked except addresses on your whitelist and your local network." Style="{StaticResource Caption}" TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>

        <CheckBox x:Name="ScheduleBox" Style="{StaticResource ToggleSwitch}" Content="Only during certain hours" Margin="0,22,0,0"
                  Checked="OnChanged" Unchecked="OnChanged" />
        <StackPanel x:Name="SchedulePanel" Margin="0,10,0,0">
          <WrapPanel x:Name="DaysPanel">
            <ToggleButton x:Name="DayMon" Content="Mon" Tag="Monday" MinWidth="52" Margin="0,0,6,6" Click="OnChanged" />
            <ToggleButton x:Name="DayTue" Content="Tue" Tag="Tuesday" MinWidth="52" Margin="0,0,6,6" Click="OnChanged" />
            <ToggleButton x:Name="DayWed" Content="Wed" Tag="Wednesday" MinWidth="52" Margin="0,0,6,6" Click="OnChanged" />
            <ToggleButton x:Name="DayThu" Content="Thu" Tag="Thursday" MinWidth="52" Margin="0,0,6,6" Click="OnChanged" />
            <ToggleButton x:Name="DayFri" Content="Fri" Tag="Friday" MinWidth="52" Margin="0,0,6,6" Click="OnChanged" />
            <ToggleButton x:Name="DaySat" Content="Sat" Tag="Saturday" MinWidth="52" Margin="0,0,6,6" Click="OnChanged" />
            <ToggleButton x:Name="DaySun" Content="Sun" Tag="Sunday" MinWidth="52" Margin="0,0,6,6" Click="OnChanged" />
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="FromBox" Width="80" TextChanged="OnChanged" FontFamily="Cascadia Mono, Consolas" />
            <TextBlock Text="to" VerticalAlignment="Center" Margin="12,0,8,0" />
            <TextBox x:Name="ToBox" Width="80" TextChanged="OnChanged" FontFamily="Cascadia Mono, Consolas" />
          </StackPanel>
          <TextBlock x:Name="ScheduleHint" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <Grid>
        <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   VerticalAlignment="Center" Margin="0,0,240,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="OkButton" Content="Save" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" Click="OnOk" />
          <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
