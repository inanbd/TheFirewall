<Window x:Class="TheFirewall.App.Views.Dialogs.SourceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login monitor" Width="900" Height="820" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,20,24,12">
        <TextBlock x:Name="HeaderText" Style="{StaticResource SectionTitle}" FontSize="20" />
        <Border x:Name="BuiltInBanner" Style="{StaticResource InfoBar}" Margin="0,12,0,0">
          <TextBlock Style="{StaticResource Body}"
                     Text="This is a built-in monitor. You can turn it on or off and change how many failed logins it allows. To change what it detects, close this window and use 'Copy as a custom monitor'." />
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Source label" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="SourceBox" ToolTip="Short name shown in the activity feed, e.g. MyApp" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="DescriptionBox" />

        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Where to look" Style="{StaticResource FieldLabel}" />
            <RadioButton x:Name="KindEventLog" GroupName="Kind" Content="Windows event log" Checked="OnKindChanged" />
            <RadioButton x:Name="KindTextFile" GroupName="Kind" Content="Text log files" Margin="0,6,0,0" Checked="OnKindChanged" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="What a match means" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="EventKindBox" HorizontalAlignment="Left" MinWidth="200">
              <ComboBoxItem Content="Failed login" Tag="Failed" />
              <ComboBoxItem Content="Successful sign-in" Tag="Successful" />
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Failed logins before a ban" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ThresholdBox" Width="90" HorizontalAlignment="Left" ToolTip="0 uses the global setting" />
            <TextBlock Text="0 = use the global setting" Style="{StaticResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>

        <!-- Event log -->
        <StackPanel x:Name="EventLogPanel">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Event log" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="LogNameBox" IsEditable="True">
                <ComboBoxItem Content="Security" />
                <ComboBoxItem Content="Application" />
                <ComboBoxItem Content="System" />
                <ComboBoxItem Content="OpenSSH/Operational" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Event filter (XPath query, optional)" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="QueryBox" FontFamily="Cascadia Mono, Consolas" ToolTip="Example: *[System[(EventID=4625)]]. Leave empty to inspect every event of the log." />
            </StackPanel>
          </Grid>
          <TextBlock Text="Expressions" Style="{StaticResource FieldLabel}" />
          <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                     Text="Each expression selects part of the event XML (XPath) and may test it with a regular expression. All required expressions must match. Capture the address with a group named ipaddress, and optionally username or source." />
          <DataGrid x:Name="ExpressionsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column"
                    Margin="0,8,0,0" MinHeight="140" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="XPath" Binding="{Binding XPath}" Width="*" FontFamily="Cascadia Mono, Consolas" />
              <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Regular expression" Binding="{Binding Regex}" Width="2*" FontFamily="Cascadia Mono, Consolas" />
              <DataGridCheckBoxColumn Header="Optional" Binding="{Binding Optional}" Width="80" MinWidth="80" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>

        <!-- Text files -->
        <StackPanel x:Name="TextFilePanel">
          <TextBlock Text="Log files (one path per line)" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="PathMasksBox" Style="{StaticResource CodeBox}" Height="72" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                     Text="Wildcards: * (any name), ** (any sub-folder). Placeholders: {year} {month} {day} and %ENVIRONMENT% variables. Example: C:\inetpub\logs\LogFiles\W3SVC*\*.log" />
          <TextBlock Text="Regular expression" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="RegexBox" Style="{StaticResource CodeBox}" Height="110" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                     Text="Named groups: ipaddress (required), username, source, timestamp. The pattern may span several lines; each line is trimmed, so use \s for spaces at the ends." />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Timestamp format (optional)" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="TimestampBox" FontFamily="Cascadia Mono, Consolas" ToolTip="Exact .NET format of the timestamp group, e.g. MM/dd/yy HH:mm:ss" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Check for new lines every (seconds)" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="PollBox" Width="90" HorizontalAlignment="Left" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- Test -->
        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Text="Try it" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="SampleHint" Style="{StaticResource Caption}" Margin="0,4,0,8" />
            <TextBox x:Name="SampleBox" Style="{StaticResource CodeBox}" Height="110" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Test" Click="OnTest" MinWidth="90" />
              <TextBlock x:Name="TestStatus" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl x:Name="ResultsList" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SuccessBar}" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource Body}">
                      <Run Text="Address" /> <Run Text="{Binding IPAddress, Mode=OneWay}" FontWeight="SemiBold" />
                      <Run Text="  ·  user" /> <Run Text="{Binding UserName, Mode=OneWay, TargetNullValue='-'}" FontWeight="SemiBold" />
                      <Run Text="  ·  source" /> <Run Text="{Binding Source, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <CheckBox x:Name="EnabledBox" Style="{StaticResource ToggleSwitch}" Content="Monitor is turned on" Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <Grid>
        <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   VerticalAlignment="Center" Margin="0,0,240,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Save" IsDefault="False" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" Click="OnOk" />
          <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
