<Window x:Class="TheFirewall.App.Views.Dialogs.FeedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a threat feed" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock Text="Add a threat feed" Style="{StaticResource SectionTitle}" FontSize="20" />
    <TextBlock Text="Any URL that returns a list of IP addresses, CIDR blocks or ranges (one per line; comments are ignored)." Style="{StaticResource Caption}" Margin="0,4,0,8" />

    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="NameBox" TextChanged="OnChanged" />
    <TextBlock Text="URL" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="UrlBox" TextChanged="OnChanged" FontFamily="Cascadia Mono, Consolas" />
    <Grid Margin="0,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Refresh every (hours)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="RefreshBox" Text="24" TextChanged="OnChanged" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Maximum entries" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="MaxBox" Text="50000" TextChanged="OnChanged" />
      </StackPanel>
    </Grid>
    <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,8,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="OkButton" Content="Add and enable" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="120" Click="OnOk" IsEnabled="False" />
      <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
