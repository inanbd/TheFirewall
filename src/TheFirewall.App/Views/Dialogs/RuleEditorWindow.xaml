<Window x:Class="TheFirewall.App.Views.Dialogs.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firewall rule" Width="640" Height="760" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,20,24,12">
        <TextBlock x:Name="HeaderText" Text="New firewall rule" Style="{StaticResource SectionTitle}" FontSize="20" />
        <Border Style="{StaticResource InfoBar}" Margin="0,12,0,0">
          <TextBlock x:Name="PreviewText" Style="{StaticResource Body}" />
        </Border>

        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" TextChanged="OnChanged" />
        <TextBlock Text="Description (optional)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="DescriptionBox" />

        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Action" Style="{StaticResource FieldLabel}" />
            <RadioButton x:Name="ActionBlock" GroupName="Action" Content="Block the connection" Checked="OnChanged" />
            <RadioButton x:Name="ActionAllow" GroupName="Action" Content="Allow the connection" Margin="0,6,0,0" Checked="OnChanged" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Direction" Style="{StaticResource FieldLabel}" />
            <RadioButton x:Name="DirectionIn" GroupName="Direction" Content="Incoming (to this computer)" Checked="OnChanged" />
            <RadioButton x:Name="DirectionOut" GroupName="Direction" Content="Outgoing (from this computer)" Margin="0,6,0,0" Checked="OnChanged" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Protocol" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="ProtocolBox" SelectionChanged="OnChanged">
          <ComboBoxItem Content="Any protocol" Tag="Any" />
          <ComboBoxItem Content="TCP (most services: RDP 3389, SSH 22, SQL 1433, web 80/443…)" Tag="Tcp" />
          <ComboBoxItem Content="UDP" Tag="Udp" />
          <ComboBoxItem Content="ICMPv4 (ping)" Tag="IcmpV4" />
          <ComboBoxItem Content="ICMPv6" Tag="IcmpV6" />
        </ComboBox>

        <Grid x:Name="PortsPanel">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Local ports (on this computer)" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="LocalPortsBox" TextChanged="OnChanged" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Remote ports" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="RemotePortsBox" TextChanged="OnChanged" />
          </StackPanel>
        </Grid>
        <TextBlock x:Name="PortsHint" Style="{StaticResource Caption}" Margin="0,4,0,0" Text="e.g. 3389 or 80, 443, 8000-8100. Leave empty for all ports." />

        <TextBlock Text="Remote addresses" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="AddressesBox" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                 FontFamily="Cascadia Mono, Consolas" TextChanged="OnChanged" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                   Text="One per line or comma separated: addresses, CIDR blocks, ranges, or LocalSubnet / Internet / Intranet. Leave empty for any address." />

        <TextBlock Text="Program (optional)" Style="{StaticResource FieldLabel}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="ProgramBox" TextChanged="OnChanged" />
          <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" />
        </Grid>

        <TextBlock Text="Network types" Style="{StaticResource FieldLabel}" />
        <StackPanel Orientation="Horizontal">
          <CheckBox x:Name="ProfileDomain" Content="Domain" Margin="0,0,20,0" />
          <CheckBox x:Name="ProfilePrivate" Content="Private" Margin="0,0,20,0" />
          <CheckBox x:Name="ProfilePublic" Content="Public" />
        </StackPanel>

        <CheckBox x:Name="EnabledBox" Style="{StaticResource ToggleSwitch}" Content="Rule is turned on" Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <Grid>
        <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   VerticalAlignment="Center" Margin="0,0,240,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="OkButton" Content="Save rule" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" Click="OnOk" />
          <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
