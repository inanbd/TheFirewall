<Window x:Class="TheFirewall.App.Views.Dialogs.BanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ban an address" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock Text="Ban an address" Style="{StaticResource SectionTitle}" FontSize="20" />
    <TextBlock Text="The address is blocked on every port until the ban ends." Style="{StaticResource Caption}" Margin="0,4,0,8" />

    <TextBlock Text="IP address" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="AddressBox" FontFamily="Cascadia Mono, Consolas" TextChanged="OnChanged" />
    <TextBlock x:Name="AddressError" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" Margin="0,4,0,0" />
    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="To block a whole network (CIDR or range), use the blacklist instead." />

    <TextBlock Text="For how long" Style="{StaticResource FieldLabel}" />
    <ComboBox x:Name="DurationBox" SelectedIndex="0">
      <ComboBoxItem Content="Normal ban duration (from settings)" Tag="" />
      <ComboBoxItem Content="1 hour" Tag="60" />
      <ComboBoxItem Content="1 day" Tag="1440" />
      <ComboBoxItem Content="1 week" Tag="10080" />
      <ComboBoxItem Content="30 days" Tag="43200" />
      <ComboBoxItem Content="Forever (until you unban it)" Tag="0" />
    </ComboBox>

    <TextBlock Text="Reason (optional)" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="ReasonBox" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="OkButton" Content="Ban" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="100" Click="OnOk" IsEnabled="False" />
      <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
